APP_ENV=dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sports_cards

# Optional locally, REQUIRED when deployed publicly:
# API_KEY        - shared secret between the Next.js server and the FastAPI backend
# SITE_PASSWORD  - password for the web login page
# SESSION_SECRET - random string used to sign the login cookie
API_KEY=
SITE_PASSWORD=
SESSION_SECRET=

# Optional: AI price research (Claude + web search). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: eBay developer keyset (developer.ebay.com > Application Keys > Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: eBay sold history (last sales per card). Free key, 100 searches/month:
# https://app.compsapi.com
COMPSAPI_KEY=
